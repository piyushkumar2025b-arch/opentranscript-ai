{
  "name": "opentranscript-ai",
  "version": "1.0.0",
  "description": "YouTube Transcriber & Multi-Provider AI Summarizer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "build:worker": "vite build && tsc src/worker.ts --outDir dist/worker --module ESNext --moduleResolution node --target ES2022 --esModuleInterop --skipLibCheck",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit --skipLibCheck",
    "test": "tsx --test 'src/**/*.test.ts'",
    "deploy": "wrangler pages deploy dist",
    "deploy:worker": "wrangler deploy",
    "cf:dev": "wrangler pages dev dist --compatibility-date=2024-01-01 --binding ENVIRONMENT=development",
    "cf:init": "wrangler pages project create opentranscript-ai",
    "d1:init": "wrangler d1 create opentranscript-db",
    "d1:migrate": "wrangler d1 execute opentranscript-db --file=./cloudflare.d1.schema.sql",
    "kv:init": "wrangler kv:namespace create CACHE"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "edge-tts-universal": "^1.4.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^3.94.0",
    "@types/express": "^4.17.21"
  }
}
