# ============================================================================
# Cloudflare Workers Environment Variables
# ============================================================================
# These variables should be set via Cloudflare Dashboard or Wrangler CLI
# Do NOT commit actual API keys to this file. Use `wrangler secret put` instead.
# ============================================================================

# ============================================================================
# 1. REQUIRED FOR BASIC FUNCTIONALITY
# ============================================================================

# GEMINI_API_KEY: Google Gemini API for summaries and Q&A
# Set via: npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=""

# GOOGLE_API_KEY: Used for YouTube Data API v3, Google Books, and Custom Search
# Set via: npx wrangler secret put GOOGLE_API_KEY
GOOGLE_API_KEY=""

# YOUTUBE_API_KEY: Alternative to GOOGLE_API_KEY for YouTube Data API
# Set via: npx wrangler secret put YOUTUBE_API_KEY
YOUTUBE_API_KEY=""

# ============================================================================
# 2. AI PROVIDER KEYS
# ============================================================================

# OPENROUTER_API_KEY: Access to Llama 3.3, DeepSeek, Claude, Qwen, etc.
# Set via: npx wrangler secret put OPENROUTER_API_KEY
OPENROUTER_API_KEY=""

# OPENAI_API_KEY: GPT-4o / GPT-4o-mini summaries and OpenAI TTS
# Set via: npx wrangler secret put OPENAI_API_KEY
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Claude 3.5 Sonnet for long-form summaries
# Set via: npx wrangler secret put ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=""

# GROQ_API_KEY: Ultra-fast Llama 3.3 70B summarization
# Set via: npx wrangler secret put GROQ_API_KEY
GROQ_API_KEY=""

# ============================================================================
# 3. WEB SEARCH & RESEARCH KEYS
# ============================================================================

# TAVILY_API_KEY: Tavily AI Research Web Search
# Set via: npx wrangler secret put TAVILY_API_KEY
TAVILY_API_KEY=""

# BRAVE_API_KEY: Brave Web Search API
# Set via: npx wrangler secret put BRAVE_API_KEY
BRAVE_API_KEY=""

# GOOGLE_CSE_ID: Google Custom Search Engine ID
# Set via: npx wrangler secret put GOOGLE_CSE_ID
GOOGLE_CSE_ID=""

# ============================================================================
# 4. NEWS & EDITORIAL KEYS
# ============================================================================

# NEWSAPI_KEY: NewsAPI.org Global News Search
# Set via: npx wrangler secret put NEWSAPI_KEY
NEWSAPI_KEY=""

# GNEWS_API_KEY: GNews.io Real-Time News Search
# Set via: npx wrangler secret put GNEWS_API_KEY
GNEWS_API_KEY=""

# ============================================================================
# 5. IMAGES & VISUAL DIAGRAMS KEYS
# ============================================================================

# UNSPLASH_ACCESS_KEY: Unsplash High-Resolution Photos
# Set via: npx wrangler secret put UNSPLASH_ACCESS_KEY
UNSPLASH_ACCESS_KEY=""

# ============================================================================
# 6. CODE & DEVELOPMENT KEYS
# ============================================================================

# GITHUB_TOKEN: GitHub Personal Access Token (5,000 req/hr)
# Set via: npx wrangler secret put GITHUB_TOKEN
GITHUB_TOKEN=""

# ============================================================================
# 7. VOICE & TRANSLATION KEYS
# ============================================================================

# ELEVENLABS_API_KEY: ElevenLabs Studio Neural TTS
# Set via: npx wrangler secret put ELEVENLABS_API_KEY
ELEVENLABS_API_KEY=""

# DEEPL_API_KEY: DeepL Neural Translation
# Set via: npx wrangler secret put DEEPL_API_KEY
DEEPL_API_KEY=""

# ============================================================================
# 8. CLOUDFLARE-SPECIFIC SETTINGS
# ============================================================================

# ENVIRONMENT: Set automatically by Cloudflare (development, preview, production)
# ENVIRONMENT="production"

# APP_URL: Your Cloudflare Pages URL or custom domain
# Example: https://opentranscript-ai.pages.dev or https://yourdomain.com
APP_URL="https://opentranscript-ai.pages.dev"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins
# Include your custom domain and any other domains that should access the API
ALLOWED_ORIGINS=""

# ============================================================================
# 9. RATE LIMITING CONFIGURATION
# ============================================================================

# Rate limiting is handled by KV namespace in Cloudflare Workers
# Default limits:
# - General API: 120 requests per minute per IP
# - LLM/AI routes: 25 requests per minute per IP

# ============================================================================
# DEPLOYMENT INSTRUCTIONS
# ============================================================================
# 
# 1. Install Wrangler CLI:
#    npm install -g wrangler
#
# 2. Authenticate with Cloudflare:
#    wrangler login
#
# 3. Set secrets via CLI (RECOMMENDED for security):
#    npx wrangler secret put GEMINI_API_KEY
#    npx wrangler secret put GOOGLE_API_KEY
#    npx wrangler secret put OPENROUTER_API_KEY
#    # ... repeat for each key
#
# 4. Or set via Cloudflare Dashboard:
#    - Go to Workers & Pages → Your Project → Settings → Variables
#    - Click "Add variable" and choose "Secret"
#    - Enter the variable name and value
#
# 5. After setting secrets, deploy:
#    npm run deploy
#
# ============================================================================
